# Copy to .env.local for local development. On Vercel these are set in
# Project → Settings → Environment Variables (the Supabase integration adds them).
NEXT_PUBLIC_SUPABASE_URL=
# Either the new publishable key or the older anon key works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Website visitors (Vercel Web Analytics). A Vercel access token from
# Account Settings → Tokens. Optional: the team id if the token sees several teams.
ANALYTICS_VERCEL_TOKEN=
ANALYTICS_VERCEL_TEAM_ID=
