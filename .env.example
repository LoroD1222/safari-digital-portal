# Copy to .env.local for local development. On Vercel these are set in
# Project → Settings → Environment Variables (the Supabase integration adds them).
NEXT_PUBLIC_SUPABASE_URL=
# Either the new publishable key or the older anon key works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
